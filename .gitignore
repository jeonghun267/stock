# 민감정보 (2026-07-24 github 업로드 대비 분리 — 절대 추적 금지)
config/secrets.ps1
config/ipc_order_auth.key
config/acl_snapshot_*.txt
.env
*.env

# 잡파일
nul
105
go

# 계약서는 추적한다 (2026-08-05 친구님 지시)
#   매수·상승보유·매도 규칙을 잠그는 파일이다. 위 *.json 에 걸려 git 밖에 있었고,
#   그러면 누가 언제 값을 바꿨는지 볼 수가 없다. 08:30 검사기는 '지금 어긋났나'만
#   알려주지 '누가 언제 바꿨나'는 못 알려준다. 두 파일만 콕 집어 되살린다.
#   config/ 를 통째로 풀지 말 것 - secrets.ps1·ipc_order_auth.key 가 같은 폴더다.
!config/lowfind_contract_v1.json
!config/sellhold_contract_v1.json

# 관리자 권한으로 실행되는 파일들의 sha256 기준표 (2026-08-05)
#   계약서와 같은 이유로 추적한다 — 08:30 검사기는 '지금 바뀌었나'만 알려주지
#   '누가 언제 바꿨나'는 못 알려준다. 이 파일이 git 밖에 있으면 기준표 자체를
#   조용히 갈아치우고 통과시킬 수 있다.
!config/elevated_path_hashes.json

# 보안 수리 백업(시스템 ACL 덤프·태스크 XML·레지스트리) - 코드가 아니고 14MB에 민감정보
backup_security_*/

# 승인 깃발 자동 백업(런타임 상태)
config/flag_reset_backup/

# 재생 산출물(계속 덧붙는 자료 - *.json/*.csv 와 같은 성격)
*.jsonl
